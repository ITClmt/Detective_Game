DATABASE_URL=postgresql://triviani:change-me@localhost:5433/triviani_detective

FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Secret de signature des access tokens (32 caractères minimum).
# Génère le tien avec : openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me

# Durées de vie des tokens, en secondes (optionnel, valeurs par défaut ci-dessous).
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Rate limiting
# TRUST_PROXY=true uniquement si l'API est derrière Traefik/Dokploy.
TRUST_PROXY=0
RATE_LIMIT_ENABLED=true
