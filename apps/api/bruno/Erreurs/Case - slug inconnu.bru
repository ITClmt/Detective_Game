}

tests {
  test("répond 404", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("code CASE_NOT_FOUND", function () {
    expect(res.getBody().error.code).to.equal("CASE_NOT_FOUND");
  });
}
