meta {
  name: Solve - payload invalide
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/cases/{{caseSlug}}/solve
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "culprit": "camille",
    "motive": "denonciation"
  }
}

tests {
  // `method` manque. `resolutionAnswersSchema` exige les trois réponses :
  // un score partiel se dit en donnant une mauvaise réponse, pas en omettant
  // la question.
  test("répond 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("code VALIDATION_ERROR", function () {
    expect(res.getBody().error.code).to.equal("VALIDATION_ERROR");
  });
}
