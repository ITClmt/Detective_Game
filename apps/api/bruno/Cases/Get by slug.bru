meta {
  name: Get by slug
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/cases/{{caseSlug}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  // La scène de départ alimente les tests de progression : la lire ici
  // évite de coder en dur une valeur du contenu, qui n'est pas versionné.
  if (res.getStatus() === 200) {
    bru.setVar("startScene", res.getBody().content.startScene);
  }
}

tests {
  test("répond 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("renvoie l'enquête demandée", function () {
    expect(res.getBody().case.slug).to.equal("chute-nicolas-verdier");
    expect(res.getBody().content).to.have.property("scenes");
  });

  test("ne fuite jamais la solution", function () {
    expect(res.getBody()).to.not.have.property("solution");
  });
}
