meta {
  name: Solve - 2 sur 3 mauvais coupable
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/cases/{{caseSlug}}/solve
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "culprit": "yann",
    "motive": "denonciation",
    "method": "insuline"
  }
}

tests {
  test("répond 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("même score que le cas précédent", function () {
    expect(res.getBody().score).to.equal(2);
  });

  test("retombe sur le catch-all quand matchAnswers ne matche pas", function () {
    // Même score 2 que « Solve - 2 sur 3 bon coupable », mais `culprit` vaut
    // `yann` : la fin ciblée sur `camille` est écartée et c'est celle sans
    // `matchAnswers` qui sort. C'est la paire de tests qui verrouille
    // `pickEnding()` dans les deux sens.
    expect(res.getBody().ending.title).to.equal("Mauvaise cible");
  });
}
