meta {
  name: Get Me
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("répond 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("renvoie l'utilisateur porté par le token", function () {
    expect(res.getBody().user.id).to.equal(bru.getVar("userId"));
    expect(res.getBody().user).to.not.have.property("password");
  });
}
