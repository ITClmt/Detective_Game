# Utilisés par docker-compose.yml pour créer l'utilisateur/la base Postgres
# au premier démarrage du conteneur.
POSTGRES_USER=triviani
POSTGRES_PASSWORD=change-me
POSTGRES_DB=triviani_detective

# Utilisé par ton API (env.ts) pour se connecter à Postgres.
# Doit reprendre exactement les 3 valeurs ci-dessus.
DATABASE_URL=postgresql://triviani:change-me@localhost:5432/triviani_detective

FRONTEND_URL=http://localhost:5173
NODE_ENV=development
